# 微信公众号 RPA 本机配置模板
# 复制为 .env 后填写；.env 已被 Git 忽略，不会提交 API Key。

# Qwen-VL：本地 OCR 多次失败后才调用。API Key 不能为空。
QWEN_VL_BASE_URL=http://192.168.33.27/v1
QWEN_VL_API_KEY=
QWEN_VL_MODEL=dashscope/qwen3-vl-plus

# MySQL 数据库配置（现行主存储）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=weixin
MYSQL_ARTICLE_TABLE=article
MYSQL_TARGET_TABLE=collection_target
MYSQL_DAILY_REPORT_TABLE=daily_report

# MongoDB（兼容历史备份访问）
MONGO_URI=mongodb://192.168.28.70:27019/
MONGO_DATABASE=weixin
MONGO_ARTICLE_COLLECTION=article
MONGO_TARGET_COLLECTION=collection_target

# 控制台（开放局域网访问前务必修改密码）
CONTROL_PANEL_USERNAME=admin
CONTROL_PANEL_PASSWORD=admin-123

# 可选：操作节奏，格式为「最少-最多」秒，每次在区间内随机取值，防止操作过快触发风控。
# 两次鼠标点击之间的最短间隔
RPA_CLICK_INTERVAL_SECONDS=0.8-1.5
# 打开下一篇文章前的停顿
RPA_ARTICLE_PAUSE_SECONDS=3-6
# 切换到下一个公众号前的停顿
RPA_ACCOUNT_PAUSE_SECONDS=8-15
